{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloud-mail",
  "main": "src/index.js",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true
  },

  "secrets": {
    "required": ["jwt_secret", "init_secret"]
  },

  "account_id": "0b602a00e69c5e6260f892a9292825f0",
  "routes": [{ "pattern": "mail.leet.uz", "custom_domain": true }],
  "d1_databases": [{
    "binding": "db",
    "database_name": "cloud-mail",
    "database_id": "a7e5bcb5-7fb1-434c-9515-51b35ca11ce8"
  }],
  "kv_namespaces": [{
    "binding": "kv",
    "id": "c0434207793249e3adcde169b21648a6"
  }],

  // R2 binding. The `r2` binding name must not be changed.
  // "r2_buckets": [
  //   {
  //     "binding": "r2",
  //     "bucket_name": ""
  //   }
  // ],

  "send_email": [{ "name": "email" }],

  "ai": {
    "binding": "ai"
  },

  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],

  "assets": {
    // The static-assets binding name must not be changed.
    "binding": "assets",
    // The Vue frontend build output directory.
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  "triggers": {
    // Runs hourly; daily maintenance methods guard on the UTC hour themselves.
    "crons": ["0 * * * *"]
  },

  "vars": {
    // "ai_model": "", // Defaults to @cf/meta/llama-3.1-8b-instruct-fast when omitted.
    // "analysis_cache": false, // Enables analytics-data caching.
    // "orm_log": false, // Enables SQL logging.
    "domain": ["leet.uz"],
    "admin": "admin@leet.uz"
  },

  // Set jwt_secret, init_secret, resend_webhook_secret, and OAuth client secrets with `wrangler secret put`.
  "build": {
    "command": "pnpm --prefix ../mail-vue install --frozen-lockfile && pnpm --prefix ../mail-vue run build"
  }
}
